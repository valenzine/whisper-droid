<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- TODO: Add <include> and <exclude> rules here to configure cloud backup.
             For more information, see https://developer.android.com/guide/topics/data/autobackup -->
        <include domain="sharedpref" path="."/>
        <exclude domain="database" path="transcript-history.db"/>
        <exclude domain="database" path="transcript-history.db-shm"/>
        <exclude domain="database" path="transcript-history.db-wal"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="database" path="transcript-history.db"/>
        <exclude domain="database" path="transcript-history.db-shm"/>
        <exclude domain="database" path="transcript-history.db-wal"/>
    </device-transfer>
</data-extraction-rules>
